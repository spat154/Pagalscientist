# Copy to .env and fill in. Never commit the real .env.

# --- Claude (content generation + verification) ---
# Without a key the pipeline still runs in deterministic dry-run mode.
ANTHROPIC_API_KEY=

# Override the default models from config/settings.yaml if you want.
# PAGAL_GENERATION_MODEL=claude-opus-4-8
# PAGAL_VERIFY_MODEL=claude-sonnet-4-6

# --- WordPress publishing target ---
# Uses the WordPress REST API with an Application Password.
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# --- Pipeline ---
# Path to the SQLite state file.
PAGAL_DB=data/pagalscientist.db
